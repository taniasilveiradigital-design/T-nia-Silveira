 "structures": [
  {
   "id": "gerundio",
   "regex": "(?i)\\b(?!(?:quando|lindo|linda|bando|comando|mando|ando|entendo|vendo|aprendo|defendo|pretendo|estendo|fundo|mundo|segundo)\\b)\\w{2,}(?:ando|endo|indo)\\b",
   "name": "Gerúndio (proibido em PT-PT)",
   "fix": "Passa para 'estar a + infinitivo' ou reescreve. 'estou analisando' fica 'estou a analisar'."
  },
  {
   "id": "nao-e-x-e-y",
   "regex": "(?i)\\bnão (?:é|se trata de) (?:apenas|só|somente) [^.!?\\n]{2,60}[,.] (?:é|trata-se)\\b",
   "name": "\"Não é só X, é Y\"",
   "fix": "Diz a coisa que queres dizer. Corta a metade da preparação."
  },
  {
   "id": "nao-so",
   "regex": "(?i)\\bnão só\\b[^.!?\\n]{2,80}\\bmas também\\b",
   "name": "\"Não só X, mas também Y\"",
   "fix": "Parte em duas frases ou corta a parte mais fraca."
  },
  {
   "id": "pergunta-encenada",
   "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o segredo|o problema|a solução)\\?\\s*$",
   "name": "Pergunta retórica numa linha sozinha",
   "fix": "Responde logo na frase. Não encenes a revelação."
  },
  {
   "id": "triade",
   "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
   "name": "Tríade (três coisas seguidas)",
   "fix": "Duas ou quatro. Três é o ritmo que a máquina escolhe sempre."
  },
  {
   "id": "emoji-ia",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF\\U0001F4AA]",
   "name": "Emoji de foguete, fogo, lâmpada, brilho, alvo ou bíceps",
   "fix": "No máximo um emoji. O teu é 🧵."
  },
  {
   "id": "hashtags",
   "regex": "#[\\wÀ-ÿ]+",
   "name": "Hashtag",
   "fix": "A Tânia não usa hashtags. Corta."
  },
  {
   "id": "como-ia",
   "regex": "(?i)\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem)\\b",
   "name": "A IA a falar de si",
   "fix": "Apaga a frase."
  },
  {
   "id": "saudacao",
   "regex": "(?im)^\\s*(?:olá|olá a todos|oi|bom dia a todos|hey)\\b",
   "name": "Saudação a abrir",
   "fix": "Começa no gancho. Ninguém veio ao feed para ser cumprimentado."
  },
  {
   "id": "voces",
   "regex": "(?i)\\b(?:você|vocês|convosco)\\b",
   "name": "\"Você\" ou \"vocês\"",
   "fix": "Fala para uma pessoa só, por tu."
  },
  {
   "id": "lista-emoji",
   "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡✔✨]\\s*\\S",
   "name": "Lista com emojis",
   "fix": "Usa hífen ou parágrafo."
  },
  {
   "id": "maiusculas",
   "regex": "\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,}",
   "name": "Três ou mais palavras em maiúsculas seguidas",
   "fix": "Uma palavra no máximo."
  },
  {
   "id": "exclamacao",
   "regex": "!{2,}|(?:![^\\n!]*){3,}",
   "name": "Exclamações a mais",
   "fix": "A força vem do conteúdo, não da exclamação."
  },
  {
   "id": "diminutivo",
   "regex": "(?i)\\b\\w+(?:zinho|zinha|zinhos|zinhas)\\b",
   "name": "Diminutivo",
   "fix": "Proibido. Soa a condescendência."
  }
 ]
}